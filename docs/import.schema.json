{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "entities": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["Event", "Place", "Community", "Organizer"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "city": {
            "default": "Belgrade",
            "type": "string",
            "maxLength": 160
          },
          "category": {
            "default": "Другое",
            "type": "string",
            "maxLength": 160
          },
          "rawCategory": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "languages": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "audience": {
            "default": "all",
            "type": "string",
            "enum": ["all", "russian-speaking", "international", "local"]
          },
          "startAt": {
            "default": "",
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "endAt": {
            "default": "",
            "anyOf": [
              {
                "type": "string",
                "const": ""
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "venue": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "address": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "latitude": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              {
                "type": "null"
              }
            ]
          },
          "longitude": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "default": "",
            "type": "string",
            "maxLength": 3000
          },
          "website": {
            "default": "",
            "type": "string",
            "maxLength": 3000
          },
          "imageUrl": {
            "default": "",
            "type": "string",
            "maxLength": 3000
          },
          "phone": {
            "default": "",
            "type": "string",
            "maxLength": 100
          },
          "price": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "openingHours": {
            "default": "",
            "type": "string",
            "maxLength": 20000
          },
          "externalId": {
            "type": "string",
            "maxLength": 500
          },
          "knownIds": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 80
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          },
          "demo": {
            "default": false,
            "type": "boolean"
          },
          "aiScore": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "aiDecision": {
            "default": "unknown",
            "type": "string",
            "enum": ["unknown", "recommended", "hidden"]
          },
          "aiReason": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ]
          },
          "aiTags": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aiProcessedAt": {
            "default": null,
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "const": ""
                  },
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["type", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["entities"],
  "additionalProperties": false
}
