# Скопируйте в .env.local. Ключи перечитываются при Test / Sync без перезапуска.
# PORT и ACTIVITY_DB требуют перезапуска.
PORT=4318
ACTIVITY_DB=../data/activity-checker/activity.sqlite
# Необязательно: собственный или альтернативный Overpass endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Рабочий адаптер
TICKETMASTER_API_KEY=
# Ниже — заготовки адаптеров. Одних ключей недостаточно: см. Sources.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TGSTAT_TOKEN=
APIFY_TOKEN=
SCRAPECREATORS_API_KEY=
MEETUP_ACCESS_TOKEN=
EVENTBRITE_TOKEN=
PREDICTHQ_TOKEN=
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
