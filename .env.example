# Скопируйте в .env.local. Ключи перечитываются при Test / Sync без перезапуска.
# PORT и ACTIVITY_DB требуют перезапуска.
PORT=4318
ACTIVITY_DB=../data/activity-checker/activity.sqlite
# Рабочие адаптеры
TICKETMASTER_API_KEY=
APIFY_TOKEN=
FOURSQUARE_API_KEY=
GOOGLE_PLACES_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Необязательно: defaults — .venv-telegram/bin/python и ../data/activity-checker/telegram/activity-checker
TELEGRAM_PYTHON=
TELEGRAM_SESSION_PATH=
