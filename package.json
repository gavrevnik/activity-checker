{
  "name": "activity-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "format": "prettier --write src server shared tests scripts docs examples *.json *.ts *.md",
    "test:http": "node --import tsx scripts/check-http.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "node-ical": "^0.22.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
